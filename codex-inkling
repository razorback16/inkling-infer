#!/bin/sh
export INKLING_KEY="$(cat "$(dirname "$0")/.proxy-key")"
exec codex -c 'model_providers.inkling.env_key="INKLING_KEY"' -c 'model_provider="inkling"' -c 'model_providers.inkling.name="Local Inkling"' -c 'model_providers.inkling.base_url="http://127.0.0.1:4010/v1"' -c 'model_providers.inkling.wire_api="responses"' -m inkling "$@"
