#!/bin/sh
export ANTHROPIC_BASE_URL=http://127.0.0.1:4010
export ENABLE_CLAUDEAI_MCP_SERVERS=false
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
export ANTHROPIC_AUTH_TOKEN="$(cat "$(dirname "$0")/.proxy-key")"
export ANTHROPIC_DEFAULT_HAIKU_MODEL=inkling ANTHROPIC_DEFAULT_SONNET_MODEL=inkling ANTHROPIC_DEFAULT_OPUS_MODEL=inkling
exec claude --model inkling "$@"
