#!/bin/bash
set -eu
cd "$(dirname "$(realpath "$0")")"
INKLING_CONTEXT_WINDOW=$(jq -er '.models[0].context_window' inkling-model.json)
export INKLING_CONTEXT_WINDOW

usage() {
  echo 'Usage: ./serve [--kv-cache-dtype bf16|fp8]'
  echo 'Defaults: FP8 E4M3 attention cache and the Inkling custom kernel.'
  echo "Context window: $INKLING_CONTEXT_WINDOW tokens including the prompt and output."
  echo 'Set INKLING_CUSTOM_KERNEL=0 to use the upstream kernel.'
}
case "$#:${1-}" in
  0:) ;;
  1:--help|1:-h) usage; exit 0 ;;
  2:--kv-cache-dtype)
    case "$2" in
      bf16|fp8) export INKLING_KV_CACHE_DTYPE="$2" ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  *) usage >&2; exit 2 ;;
esac
export LITELLM_MASTER_KEY="$(cat .proxy-key)"
.venv/bin/python backend.py --chat-template-args '{"reasoning_effort":"low"}' --model thinkingmachines/Inkling-2-Mini --prefill-step-size 2048 --host 127.0.0.1 --port 8089 &
backend=$!
trap 'kill "$backend" 2>/dev/null || true' EXIT
while ! curl -fsS http://127.0.0.1:8089/v1/models >/dev/null 2>&1; do
  kill -0 "$backend" || exit 1
  sleep 1
done
.venv/bin/litellm --config proxy.yaml --host 127.0.0.1 --port 4010
