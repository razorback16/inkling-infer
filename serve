#!/bin/bash
set -eu
cd "$(dirname "$(realpath "$0")")"
INKLING_CONTEXT_WINDOW=$(jq -er '.models[0].context_window' inkling-model.json)
export INKLING_CONTEXT_WINDOW

usage() {
  echo 'Usage: ./serve [--kv-cache-dtype bf16|fp8]'
  echo 'Defaults: native Metal backend and BF16 attention cache.'
  echo "Context window: $INKLING_CONTEXT_WINDOW tokens including the prompt and output."
}
case "$#:${1-}" in
  0:) ;;
  1:--help|1:-h) usage; exit 0 ;;
  2:--kv-cache-dtype)
    case "$2" in
      bf16|fp8) export INKLING_KV_CACHE_DTYPE="$2" ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  *) usage >&2; exit 2 ;;
esac
if [[ ! -s .proxy-key ]]; then
  echo 'Create .proxy-key using the setup command in README.md, then run serve again.' >&2
  exit 1
fi
LITELLM_MASTER_KEY=$(cat .proxy-key)
if [[ -z "$LITELLM_MASTER_KEY" ]]; then
  echo '.proxy-key must contain a proxy key.' >&2
  exit 1
fi
export LITELLM_MASTER_KEY
make -s -C native
python_bin="${INKLING_PYTHON:-.venv/bin/python}"
backend_port="${INKLING_BACKEND_PORT:-8089}"
export INKLING_API_BASE="http://127.0.0.1:$backend_port/v1"
ready=$(mktemp -t inkling-ready)
"$python_bin" backend.py --port "$backend_port" --ready-file "$ready" &
backend=$!
trap 'kill "$backend" 2>/dev/null || true; rm -f "$ready"' EXIT
while [[ ! -s "$ready" ]]; do
  kill -0 "$backend" || exit 1
  sleep 1
done
kill -0 "$backend" 2>/dev/null || exit 1
"$(dirname "$python_bin")/litellm" --config proxy.yaml --host 127.0.0.1 --port "${INKLING_PROXY_PORT:-4010}"
